{
  "name": "todolist-c",
  "productName": "TodoList_C",
  "version": "0.1.0",
  "description": "Lista diária de atividades pessoais e profissionais (saladaMista)",
  "author": "saladaMista",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:local": "electron-vite dev --mode edicao-local",
    "build": "electron-vite build",
    "build:local": "electron-vite build --mode edicao-local",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "dist:win": "electron-vite build && electron-builder --win",
    "test:e2e": "electron-vite build && playwright test e2e/paper.spec.ts",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "test:e2e:local": "electron-vite build --mode edicao-local && playwright test e2e/local.spec.ts",
    "dist:local": "electron-vite build --mode edicao-local && electron-builder --win --config electron-builder.local.yml"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
